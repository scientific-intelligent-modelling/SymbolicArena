      ],
      "comments": "DSO/uDSR 回归环境；依赖本地源码路径导入，不强制编译 cyfunc 扩展"
    },
    "sim_tpsr": {
      "python_version": "3.9",
      "conda_packages": [
        "pip",
        "pytorch",
        "numpy",
        "scikit-learn",
        "matplotlib",
        "pandas",
        "sympy",
        "h5py"
      ],
      "channels": [
        "conda-forge",
        "pytorch"
      ],
      "pip_packages": [
        "timeout-decorator",
        "numexpr",
        "sympytorch",
        "gym==0.26.2",
        "gym-notices==0.0.8",
        "tqdm==4.64.0",
        "click==8.1.8",
        "dataclass-dict-convert",
        "hydra-core==1.0.0",
        "jsons",
        "ordered-set",
        "pytorch-lightning"
      ],
      "comments": "TPSR (Transformer-based Planning for Symbolic Regression)环境",
      "post_install_commands": [
        "pip install -e .",
        "pip install --no-deps -e ./scientific_intelligent_modelling/algorithms/tpsr_wrapper/tpsr/nesymres/src",
        "python -c \"from pathlib import Path; import urllib.request; p=Path('scientific_intelligent_modelling/algorithms/e2esr_wrapper/model.pt'); p.parent.mkdir(parents=True, exist_ok=True); p.exists() or urllib.request.urlretrieve('https://dl.fbaipublicfiles.com/symbolicregression/model1.pt', str(p))\""
      ]
    },
    "sim_ragsr": {
      "python_version": "3.10",
      "conda_packages": [
        "pip"
      ],
      "channels": [
        "conda-forge",
        "pytorch"
      ],
      "pip_packages": [
        "numpy",
        "pandas",
        "scikit-learn",
        "sympy",
        "networkx"
      ],
      "comments": "RAG-SR / EvolutionaryForest 环境；仓库通过 PYTHONPATH=. 暴露，post_install_commands 只安装外部依赖，避免 tpot/xgboost 最新依赖触发源码构建",
      "post_install_commands": [
        "pip install --timeout 120 --retries 5 torch --index-url https://download.pytorch.org/whl/cpu",
        "pip install --timeout 120 --retries 5 PyYAML==6.0.3 category-encoders==2.8.1 deap==1.4.4 dill==0.4.1 lightgbm==3.3.5 linear-tree==0.3.5 mlxtend==0.23.4 sklearn2pmml==0.130.0 smt==2.13.0 umap-learn==0.5.12 hdfe==0.0.4 scorch==0.2.0 seaborn==0.13.2 matplotlib==3.10.9 cachetools==6.2.6 gplearn==0.4.2 faiss-cpu==1.13.0 skorch==1.2.0 shap==0.49.1 xgboost==2.1.4 pytest",
        "pip install --no-deps evolutionary-forest==0.2.5"
      ]
    },
