{
  "tool": "pysr",
  "description": "pysr note wrapper note v0.1 ",
  "system_params": {
    "problem_name": {
      "type": "string",
      "action": "strip",
      "description": "experiment meta-parameter not used for algorithm training"
    },
    "seed": {
      "type": "int",
      "action": "map",
      "target": "random_state",
      "description": "experiment meta-parameter note random_state note random_state"
    },
    "exp_name": {
      "type": "string",
      "action": "strip",
      "description": "experiment meta-parameter not used for algorithm training"
    },
    "exp_path": {
      "type": "string",
      "action": "strip",
      "description": "experiment meta-parameter not used for algorithm training"
    },
    "timeout_in_seconds": {
      "type": "int",
      "action": "passthrough",
      "description": "PySR note note  note"
    }
  },
  "allowed_params": {
    "niterations": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "max_evals": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "early_stop_condition": {
      "type": "float|string",
      "required": false,
      "default": null
    },
    "population_size": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "populations": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "ncycles_per_iteration": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "maxsize": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "maxdepth": {
      "type": "int",
      "range": "[1, +inf)",
      "required": false,
      "default": null
    },
    "procs": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "n_jobs": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null,
      "note": "note procs"
    },
    "parsimony": {
      "type": "float",
      "range": "[0, +inf)",
      "required": false,
      "default": null
    },
    "constraints": {
      "type": "dict",
      "required": false,
      "default": null
    },
    "nested_constraints": {
      "type": "dict",
      "required": false,
      "default": null
    },
    "complexity_of_operators": {
      "type": "dict",
      "required": false,
      "default": null
    },
    "complexity_of_constants": {
      "type": "int|float",
      "required": false,
      "default": null
    },
    "complexity_of_variables": {
      "type": "int|float|list",
      "required": false,
      "default": null
    },
    "binary_operators": {
      "type": "string|list|tuple",
      "required": false,
      "default": null
    },
    "unary_operators": {
      "type": "string|list|tuple",
      "required": false,
      "default": null
    },
    "elementwise_loss": {
      "type": "string",
      "required": false,
      "default": null
    },
    "model_selection": {
      "type": "string",
      "required": false,
      "default": null
    },
    "loss_function": {
      "type": "string",
      "required": false,
      "default": null
    },
    "warm_start": {
      "type": "bool",
      "required": false,
      "default": false
    },
    "progress": {
      "type": "bool",
      "required": false,
      "default": true
    },
    "verbosity": {
      "type": "int",
      "range": "[0, +inf)",
      "required": false,
      "default": null
    },
    "random_state": {
      "type": "int",
      "required": false,
      "default": null
    },
    "precision": {
      "type": "int",
      "required": false,
      "default": null
    },
    "deterministic": {
      "type": "bool",
      "required": false,
      "default": false
    },
    "parallelism": {
      "type": "string",
      "required": false,
      "default": null,
      "enum": ["serial", "multithreading", "multiprocessing"]
    }
  },
  "constraints": {
    "resource_alias": {
      "rule": "note n_jobs note procs note prefer procs"
    }
  },
  "compatibility": {
    "notes": [
      "pysr note note sim_base environment note",
      "wrapper note note"
    ]
  }
}
