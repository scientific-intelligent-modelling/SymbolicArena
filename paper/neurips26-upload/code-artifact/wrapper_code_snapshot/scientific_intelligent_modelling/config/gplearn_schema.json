{
  "tool": "gplearn",
  "description": "gplearn note wrapper note v0.1 ",
  "system_params": {
    "problem_name": {
      "type": "string",
      "action": "strip",
      "description": "experiment meta-parameter not used for algorithm training"
    },
    "seed": {
      "type": "int",
      "action": "map",
      "target": "random_state",
      "description": "experiment meta-parameter note random_state note random_state"
    },
    "exp_name": {
      "type": "string",
      "action": "strip",
      "description": "experiment meta-parameter not used for algorithm training"
    },
    "exp_path": {
      "type": "string",
      "action": "strip",
      "description": "experiment meta-parameter not used for algorithm training"
    },
    "timeout_in_seconds": {
      "type": "int",
      "action": "strip",
      "description": "note note note gplearn"
    }
  },
  "allowed_params": {
    "population_size": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "generations": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "tournament_size": {
      "type": "int",
      "range": "(1, +inf)",
      "required": false,
      "default": null
    },
    "stopping_criteria": {
      "type": "float",
      "range": "[0, +inf)",
      "required": false,
      "default": null
    },
    "parsimony_coefficient": {
      "type": "float",
      "range": "[0, +inf)",
      "required": false,
      "default": null
    },
    "p_crossover": {
      "type": "float",
      "range": "[0, 1]",
      "required": false,
      "default": null
    },
    "p_subtree_mutation": {
      "type": "float",
      "range": "[0, 1]",
      "required": false,
      "default": null
    },
    "p_hoist_mutation": {
      "type": "float",
      "range": "[0, 1]",
      "required": false,
      "default": null
    },
    "p_point_mutation": {
      "type": "float",
      "range": "[0, 1]",
      "required": false,
      "default": null
    },
    "p_point_replace": {
      "type": "float",
      "range": "[0, 1]",
      "required": false,
      "default": null
    },
    "function_set": {
      "type": "list|tuple|string",
      "required": false,
      "default": "gplearn default note"
    },
    "const_range": {
      "type": "tuple|list|string",
      "required": false,
      "default": null,
      "description": "note2note(low, high)"
    },
    "init_depth": {
      "type": "int|tuple",
      "required": false,
      "default": null
    },
    "init_method": {
      "type": "enum",
      "candidates": ["half and half", "grow", "full"],
      "required": false,
      "default": null
    },
    "metric": {
      "type": "str",
      "required": false,
      "default": null
    },
    "max_samples": {
      "type": "float",
      "range": "(0, +inf)",
      "required": false,
      "default": null
    },
    "random_state": {
      "type": "int",
      "required": false,
      "default": null
    },
    "n_jobs": {
      "type": "int",
      "range": "(0, +inf)",
      "required": false,
      "default": 1
    },
    "verbose": {
      "type": "int",
      "range": "[0, +inf)",
      "required": false,
      "default": 0
    },
    "low_memory": {
      "type": "bool",
      "required": false,
      "default": false
    },
    "warm_start": {
      "type": "bool",
      "required": false,
      "default": false
    }
  },
  "constraints": {
    "mutation_probability_sum": {
      "params": [
        "p_crossover",
        "p_subtree_mutation",
        "p_hoist_mutation",
        "p_point_mutation",
        "p_point_replace"
      ],
      "rule": "note [0,1] note1.0"
    }
  },
  "compatibility": {
    "notes": [
      "note sklearn>=1.7.0 note gplearn 0.4.3 note _validate_data note wrapper note",
      "note exp_path/exp_name/problem_name/seed note note gplearn SymbolicRegressor"
    ]
  }
}
