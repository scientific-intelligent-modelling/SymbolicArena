{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symbolicarena.equivalence.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["equivalent", "not_equivalent", "undetermined"]
    },
    "evidence_basis": {
      "type": "string",
      "enum": [
        "symbolic_proof",
        "numerical_support",
        "structural_analysis",
        "mixed",
        "insufficient"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 8
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "brief_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "decision",
    "evidence_basis",
    "assumptions",
    "confidence",
    "brief_reason"
  ]
}
