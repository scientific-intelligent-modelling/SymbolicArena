{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symbolicarena.structure.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "mathematically_equivalent",
        "same_canonical_structure",
        "different_structure",
        "undetermined"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "brief_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": ["decision", "confidence", "brief_reason"]
}
