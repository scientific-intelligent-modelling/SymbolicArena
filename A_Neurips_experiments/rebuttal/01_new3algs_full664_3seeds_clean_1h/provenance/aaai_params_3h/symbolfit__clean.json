{
  "timeout_in_seconds": 10800,
  "progress_snapshot_interval_seconds": 60,
  "niterations": 1000000,
  "maxsize": 25,
  "model_selection": "accuracy",
  "binary_operators": [
    "+",
    "*",
    "/",
    "-"
  ],
  "unary_operators": [
    "sin",
    "cos",
    "exp",
    "log"
  ],
  "max_complexity": 25,
  "input_rescale": true,
  "scale_y_by": "mean",
  "max_stderr": 20,
  "fit_y_unc": false,
  "y_uncertainty": 1.0,
  "procs": 1,
  "parallelism": "serial",
  "deterministic": true,
  "train_label_noise_sigma": 0.0,
  "train_label_noise_enabled": false
}
